{
  "section": "7.01",
  "apis": [
    {
      "method": "GET",
      "path": "/api/dgft/sections/7.01",
      "purpose": "Retrieve knowledge payload for section 7.01",
      "query_params": [
        "include=workflow,decision_tree,validations"
      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/General-Provision/validate",
      "purpose": "Validate inputs and documents for General Provision",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/General-Provision/execute",
      "purpose": "Trigger business action for 7.01 General Provision\n(a) Supplier / Recipient of goods shall submit application for claiming\ndeemed export benefits, in ANF-7A, along with the documents prescribed\ntherein, to the Jurisdictional RA as per Appendix 1A except for category (b)\nmentioned therein.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
        "reference_id",
        "status",
        "authority",
        "timeline"
      ]
    }
  ]
}