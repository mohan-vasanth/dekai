        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Maintenance-of-Accounts/execute",
      "purpose": "Trigger business action for 6.11 Maintenance of Accounts\na) EOU / EHTP / STP / BTP unit shall maintain proper account, and\nshall file digitally signed quarterly and annual report as prescribed\nin Annexure to Appendix 6E of Appendices & ANFs to DC /\nDesignated Officer in Meit Y / Do BT and Customs and Central Excise\nauthorities.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
