        "include=workflow,decision_tree,validations"
      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Maintenance-of-Accounts/validate",
      "purpose": "Validate inputs and documents for Maintenance of Accounts",
