      "path": "/api/dgft/Maintenance-of-Proper-Accounts-for-Authorisations-issued-under/validate",
      "purpose": "Validate inputs and documents for Maintenance of Proper Accounts for Authorisations issued under",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted"
      ],
      "response_fields": [
