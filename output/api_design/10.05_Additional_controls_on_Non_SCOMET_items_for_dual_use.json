{
  "section": "10.05",
  "apis": [
    {
      "method": "GET",
      "path": "/api/dgft/sections/10.05",
      "purpose": "Retrieve knowledge payload for section 10.05",
      "query_params": [
        "include=workflow,decision_tree,validations"
      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Additional-controls-on-Non-SCOMET-items-for-dual-use/validate",
      "purpose": "Validate inputs and documents for Additional controls on Non-SCOMET items for dual use",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Additional-controls-on-Non-SCOMET-items-for-dual-use/execute",
      "purpose": "Trigger business action for 10.05 Additional controls on Non-SCOMET items for dual use\n(Catch-all controls)\nIf the exporter has been notified in writing by DGFT or he knows or has reason to\nbelieve that an item not covered in the SCOMET list has a potential risk of use in or\ndiversion to Weapons of Mass Destruction (WMD) or in missile system or military\nuse (including by terrorists and non-state actors), he shall apply for a SCOMET\nauthorisation.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted",
        "document_4_submitted"
      ],
      "response_fields": [
        "reference_id",
        "status",
        "authority",
        "timeline"
      ]
    }
  ]
}