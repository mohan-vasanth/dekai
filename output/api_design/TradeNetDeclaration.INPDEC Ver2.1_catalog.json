          "method": "POST",
          "path": "/api/dgft/MESSAGE-FUNCTION/execute",
          "purpose": "Trigger business action for Transfer conditions are:\nCode Declaration Type Transfer Conditions\nSFZ Storage in FTZ To allow the Declarant to submit Declarations for storage of non-\ndutiable goods and certain dutiable goods in the FTZ\nAPS Approved Premises/Schemes To allow the Declarant to submit Declarations such as:\na) ME\nb) Bonding of goods into a LW\nc) Bonding of goods into a BW\nd) CFW\ne) Class II cargoes\nNote: In general, any references to “LW” (or Licensed Warehouse) and\n“BW” (or Bonded Warehouse) refer to licensed premises used for storing\ndutiable and non-dutiable goods, respectively.",
          "request_fields": [
            "section_code",
            "section_title",
            "document_1_submitted",
            "document_2_submitted",
            "document_3_submitted",
            "document_4_submitted",
            "document_5_submitted",
            "document_6_submitted"
          ],
          "response_fields": [
