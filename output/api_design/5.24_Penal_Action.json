{
  "section": "5.24",
  "apis": [
    {
      "method": "GET",
      "path": "/api/dgft/sections/5.24",
      "purpose": "Retrieve knowledge payload for section 5.24",
      "query_params": [
        "include=workflow,decision_tree,validations"
      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Penal-Action/validate",
      "purpose": "Validate inputs and documents for Penal Action",
      "request_fields": [
        "section_code",
        "section_title"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Penal-Action/execute",
      "purpose": "Trigger business action for 5.24 Penal Action\nIn case of failure to fulfil export obligation or any other condition of\nauthorisation, authorisation holder shall be liable for action under FT (D&R) Act,\n1992, as amended, Orders and Rules made thereunder, provisions of FTP/HBP,\nCustoms Act, 1962, as amended from time to time or any other law in force.",
      "request_fields": [
        "section_code",
        "section_title"
      ],
      "response_fields": [
        "reference_id",
        "status",
        "authority",
        "timeline"
      ]
    }
  ]
}