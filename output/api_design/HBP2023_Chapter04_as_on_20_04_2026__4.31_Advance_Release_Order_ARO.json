      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Advance-Release-Order-ARO/validate",
      "purpose": "Validate inputs and documents for Advance Release Order (ARO)",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Advance-Release-Order-ARO/execute",
      "purpose": "Trigger business action for A suitable documentary\nevidence as outlined in Para 4.30 (c) of HBP shall be submitted, if applicable.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted"
      ],
      "response_fields": [
