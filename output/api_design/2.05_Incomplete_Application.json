        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Incomplete-Application/execute",
      "purpose": "Trigger business action for 2.05 Incomplete Application\n(a) An incomplete or unauthorised application is liable to be rejected by the competent\nauthority with specific reason for rejection.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted",
        "document_3_submitted"
