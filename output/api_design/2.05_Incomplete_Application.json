      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Incomplete-Application/validate",
      "purpose": "Validate inputs and documents for Incomplete Application",
