{
  "section": "2.61",
  "apis": [
    {
      "method": "GET",
      "path": "/api/dgft/sections/2.61",
      "purpose": "Retrieve knowledge payload for section 2.61",
      "query_params": [
        "include=workflow,decision_tree,validations"
      ],
      "response_fields": [
        "section",
        "title",
        "summary",
        "conditions",
        "validations",
        "exceptions",
        "workflow",
        "decision_tree"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Sale-of-Exhibits/validate",
      "purpose": "Validate inputs and documents for Sale of Exhibits",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted"
      ],
      "response_fields": [
        "status",
        "errors",
        "warnings",
        "next_actions"
      ]
    },
    {
      "method": "POST",
      "path": "/api/dgft/Sale-of-Exhibits/execute",
      "purpose": "Trigger business action for 2.61 Sale of Exhibits\n(a) Restricted Items: Sale of exhibits of restricted items, mentioned in ITC (HS),\nimported for an international exhibition / fair may also be made, without an\nAuthorisation within bond period allowed for re-export, on payment of\napplicable customs duties, subject to a ceiling limit of Rs.5 lakh (CIF) for such\nexhibits for each exhibitor.",
      "request_fields": [
        "section_code",
        "section_title",
        "document_1_submitted",
        "document_2_submitted"
      ],
      "response_fields": [
        "reference_id",
        "status",
        "authority",
        "timeline"
      ]
    }
  ]
}